<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Single-file publish settings -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>        <!-- pick win-x86 / win-arm64 if needed -->
    <SelfContained>true</SelfContained>                  <!-- include the .NET runtime -->
    <PublishSingleFile>true</PublishSingleFile>          <!-- bundle everything into one file -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>               <!-- keep false until you test trimming -->
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>

    <!-- avoid shipping symbol files and extra pdb/deps when publishing single-file -->
    <DebugType>none</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.44.0" />
  </ItemGroup>

</Project>